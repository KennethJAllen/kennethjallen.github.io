---
import { Image } from 'astro:assets';

interface Props {
  href?: string;
  title: string;
  summary?: string;
  image: ImageMetadata;
  imageAlt: string;
  video?: string;
  loading?: 'eager' | 'lazy';
}

const { href, title, summary, image, imageAlt, video, loading = 'lazy' } = Astro.props;
const Wrapper = href ? 'a' : 'div';
const wrapperProps = href
  ? { href, class: 'card-image', 'aria-label': title, rel: 'noopener' }
  : { class: 'card-image' };
---
<article class="card">
  <Wrapper {...wrapperProps}>
    {video ? (
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={image.src}
        aria-label={imageAlt}
      >
        <source src={`${video}.webm`} type="video/webm" />
        <source src={`${video}.mp4`} type="video/mp4" />
      </video>
    ) : (
      <Image
        src={image}
        alt={imageAlt}
        widths={[600, 900, 1200]}
        sizes="(min-width: 1380px) 340px, (min-width: 1100px) 28vw, (min-width: 600px) 45vw, 100vw"
        loading={loading}
      />
    )}
  </Wrapper>
  <div class="card-body">
    <h3>{href ? <a href={href} rel="noopener">{title}</a> : title}</h3>
    {summary && <p>{summary}</p>}
  </div>
</article>
