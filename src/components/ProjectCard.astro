---
import { Image } from 'astro:assets';

interface Props {
  href?: string;
  title: string;
  summary?: string;
  image: ImageMetadata;
  imageAlt: string;
  loading?: 'eager' | 'lazy';
}

const { href, title, summary, image, imageAlt, loading = 'lazy' } = Astro.props;
---
<article class="card">
  {href ? (
    <a href={href} class="card-image" aria-label={title} rel="noopener">
      <Image
        src={image}
        alt={imageAlt}
        widths={[600, 900, 1200]}
        sizes="(min-width: 1380px) 340px, (min-width: 1100px) 28vw, (min-width: 600px) 45vw, 100vw"
        loading={loading}
      />
    </a>
  ) : (
    <div class="card-image">
      <Image
        src={image}
        alt={imageAlt}
        widths={[600, 900, 1200]}
        sizes="(min-width: 1380px) 340px, (min-width: 1100px) 28vw, (min-width: 600px) 45vw, 100vw"
        loading={loading}
      />
    </div>
  )}
  <div class="card-body">
    <h3>{href ? <a href={href} rel="noopener">{title}</a> : title}</h3>
    {summary && <p>{summary}</p>}
  </div>
</article>
