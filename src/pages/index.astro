---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import aboutMe from '../assets/images/aboutme.jpg';
import avatar from '../assets/images/avatar.png';
import banner from '../assets/images/banner.png';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const papers = (await getCollection('papers')).sort(
  (a, b) => a.data.order - b.data.order,
);

const siteUrl = Astro.site!.toString();
const avatarImg = await getImage({ src: avatar, width: 360, height: 360, fit: 'cover' });
const description =
  'Data scientist and mathematician. PhD in numerical analysis, with research on low-rank matrix completion, nuclear fusion simulation, and reinforcement learning.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Kenneth Allen',
      givenName: 'Kenneth',
      familyName: 'Allen',
      honorificPrefix: 'Dr.',
      honorificSuffix: 'PhD',
      url: siteUrl,
      image: new URL(avatarImg.src, Astro.site).toString(),
      jobTitle: 'Data Scientist',
      description,
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Georgia',
      },
      knowsAbout: [
        'Numerical analysis',
        'Low-rank matrix completion',
        'Dynamic mode decomposition',
        'Nuclear fusion simulation',
        'Reinforcement learning',
      ],
      sameAs: [
        'https://github.com/KennethJAllen',
        'https://www.linkedin.com/in/kennethallenmath/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Kenneth Allen',
      publisher: { '@id': `${siteUrl}#person` },
    },
  ],
};
---
<Base title="Kenneth Allen — Data Scientist & Mathematician, PhD" description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)}></script>
  <section id="top" class="page-section hero" style={`background-image: url(${banner.src})`}>
    <div class="container">
      <div class="hero-text">
        <h1>Hi, I'm<br />Dr. Kenneth Allen.</h1>
      </div>
    </div>
  </section>

  <section id="portfolio" class="page-section">
    <div class="container">
      <h2>Portfolio</h2>
      <div class="project-grid">
        {projects.map((p, i) => (
          <ProjectCard
            href={`/projects/${p.id}/`}
            title={p.data.title}
            summary={p.data.summary}
            image={p.data.image}
            imageAlt={p.data.imageAlt}
            video={p.data.video}
            loading={i < 6 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
    </div>
  </section>

  <section id="papers" class="page-section">
    <div class="container">
      <h2>Papers &amp; Dissertation</h2>
      <div class="project-grid">
        {papers.map((p) => (
          <ProjectCard
            href={`/papers/${p.id}/`}
            title={p.data.title}
            summary={p.data.venue ?? undefined}
            image={p.data.image}
            imageAlt={p.data.imageAlt}
          />
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="page-section">
    <div class="container">
      <h2>About</h2>
      <div class="about">
        <Image src={aboutMe} alt="Kenneth Allen" widths={[400, 600, 800]} sizes="(min-width: 720px) 40vw, 100vw" />
        <div>
          <p>
            Data scientist, PhD in Mathematics. Numerical analysis research 
            supporting ML applications for data completion and nuclear fusion 
            simulation. Experience in modeling and simulation for diverse fields 
            including aviation, nuclear fusion, and oncology.
          </p>
          <p>
            In my free time, I enjoy yoga and exploring restaurants and <a href="https://docs.google.com/spreadsheets/d/1hNrP-fycwsPOH5xp-GcDjjm9GtxcvnRng2Zk4MMmQ4A">coffee shops</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="page-section">
    <div class="container">
      <h2>Contact</h2>
      <p>
        Feel free to reach out on
        {' '}<a href="https://www.linkedin.com/in/kennethallenmath/">LinkedIn</a>
        {' '}or <a href="https://github.com/KennethJAllen">GitHub</a>.
      </p>
    </div>
  </section>
</Base>
